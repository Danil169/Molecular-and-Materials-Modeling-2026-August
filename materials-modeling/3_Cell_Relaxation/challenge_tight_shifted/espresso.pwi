&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp_ase'
   prefix           = 'si_tight_ase'
   pseudo_dir       = '../..'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 65
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   ntyp             = 1
   nat              = 2
/
&ELECTRONS
   conv_thr         = 1e-12
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
