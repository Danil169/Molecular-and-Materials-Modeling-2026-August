&CONTROL
  calculation = 'vc-relax'
  prefix = 'si_tight_direct'
  pseudo_dir = '../..'
  outdir = './tmp_direct'
  tstress = .true.
  tprnfor = .true.
  etot_conv_thr = 1.0d-8
  forc_conv_thr = 1.0d-5
  nstep = 100
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 65
  occupations = 'smearing'
  smearing = 'gauss'
  degauss = 0.01
/
&ELECTRONS
  conv_thr = 1.0d-12
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
  press_conv_thr = 0.1
/
ATOMIC_SPECIES
Si 28.085 Si.upf

K_POINTS automatic
15 15 15 0 0 0

CELL_PARAMETERS angstrom
0.0000000000 2.7149000000 2.7149000000
2.7149000000 0.0000000000 2.7149000000
2.7149000000 2.7149000000 0.0000000000

ATOMIC_POSITIONS angstrom
Si 1.4074500000 4.0423500000 4.0923500000
Si 0.0000000000 0.0000000000 0.0000000000
