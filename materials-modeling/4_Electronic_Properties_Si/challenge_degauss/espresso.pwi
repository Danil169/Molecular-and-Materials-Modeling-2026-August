&CONTROL
   calculation      = 'nscf'
   verbosity        = 'low'
   wf_collect       = .true.
   outdir           = './tmp'
   prefix           = 'dg020'
   pseudo_dir       = '../..'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 65
   nosym            = .true.
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gauss'
   ntyp             = 1
   nat              = 2
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
