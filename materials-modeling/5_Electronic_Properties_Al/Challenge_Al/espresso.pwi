&CONTROL
   calculation      = 'nscf'
   wf_collect       = .true.
   outdir           = './tmp'
   prefix           = 'Al_Elec'
   pseudo_dir       = '../../'
/
&SYSTEM
   ecutwfc          = 50
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
