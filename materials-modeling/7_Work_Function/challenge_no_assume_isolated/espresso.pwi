&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'graphene_none'
   pseudo_dir       = '../..'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 100
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   ntyp             = 1
   nat              = 2
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
