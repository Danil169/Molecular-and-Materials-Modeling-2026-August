&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'h_100Ry'
   pseudo_dir       = '../..'
/
&SYSTEM
   ibrav            = 0
   nat              = 1
   ntyp             = 1
   ecutwfc          = 100
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   nspin            = 2
   vdw_corr         = 'DFT-D3'
   dftd3_version    = 4
   starting_magnetization(1) = 0.0
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
H  1.008 H.upf

K_POINTS automatic
1 1 1  0 0 0

CELL_PARAMETERS angstrom
10.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 10.00000000000000 0.00000000000000
0.00000000000000 0.00000000000000 10.00000000000000

ATOMIC_POSITIONS angstrom
H  5.0000000000 5.0000000000 5.0000000000  

