&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'ch4_pbe'
   pseudo_dir       = '/usr/share/espresso/pseudo'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 46.0
   ecutrho          = 184.0
   nosym            = .true.
   noinv            = .true.
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gaussian'
   ntyp             = 2
   nat              = 5
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.7
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
