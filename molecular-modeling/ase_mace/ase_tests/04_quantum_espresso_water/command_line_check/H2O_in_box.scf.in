&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './outdir'
   prefix           = 'h2o'
   pseudo_dir       = '/usr/share/espresso/pseudo/'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 50.0
   ecutrho          = 350.0
   nosym            = .true.
   noinv            = .true.
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gaussian'
   ntyp             = 2
   nat              = 3
/
&ELECTRONS
   conv_thr         = 1e-08
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
O 15.999 O.pbe-kjpaw.UPF
H 1.008  H.pbe-kjpaw.UPF

K_POINTS automatic
1 1 1  0 0 0

CELL_PARAMETERS angstrom
12.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 12.00000000000000 0.00000000000000
0.00000000000000 0.00000000000000 12.00000000000000

ATOMIC_POSITIONS angstrom
O 6.0000000000 6.0000000000 6.2981545000  
H 6.0000000000 6.7632390000 5.7018455000  
H 6.0000000000 5.2367610000 5.7018455000  

